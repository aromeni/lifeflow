# LifeFlow AI — environment configuration template.
# Copy to .env and adjust. NEVER commit .env or real secrets.
# Only variables consumed by the current stage are listed; later stages add
# their own here (documented, never silently).

# --- Database (docker compose db service) -----------------------------------
# Host port for PostgreSQL. 5433 by default to avoid clashing with any local
# Postgres already on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lifeflow:lifeflow@localhost:5433/lifeflow # pragma: allowlist secret

# --- API ---------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Secrets (generate your own; never commit real values) -------------------
# Signs the session cookie. Optional in development (ephemeral secret is
# generated at startup); REQUIRED in production.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Encrypts OAuth tokens at rest (AES-256-GCM). Required once accounts connect.
# This is always the ACTIVE key — every new encryption uses it.
# Generate: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_KEY=
# Identifier for the key above; changes when the key is rotated.
TOKEN_KEY_ID=dev-1
# Stage 11A Phase 4A: zero-or-more LEGACY keys, retained only long enough for
# credential_rotation.py to migrate rows off them. A JSON array of
# {"key": "<base64>", "key_id": "<id>"} objects; empty (the default) means no
# legacy keys. Never reuse a key id already used above.
TOKEN_KEY_LEGACY_JSON=

# --- LLM-assisted extraction (optional) ---------------------------------------
# Real model calls are DISABLED by default: a key alone does nothing.
# LLM_EXTRACTION_ENABLED must be set to true explicitly, and per ADR 0002 it
# stays false until a real-provider evaluation has been run and recorded.
# Demo mode, tests, and CI never need any of these.
LLM_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Real Google integration (optional, Stage 7 / ADR 0003) -------------------
# Disabled by default: demo mode, dev-login, and the synthetic connectors work
# with none of this set. Setting GOOGLE_OAUTH_ENABLED=true requires BOTH
# client configs below (the app refuses to start otherwise) — they are
# deliberately separate Google Cloud OAuth clients, never one shared client:
#   - the OIDC client signs users into LifeFlow itself (openid email profile
#     only; never mailbox/calendar access);
#   - the connector client is requested only from the Connections screen and
#     carries the four data scopes (gmail.readonly, gmail.compose,
#     calendar.readonly, calendar.events).
# Test against a sandbox Google account on the "Testing" consent-screen
# status first — never a primary mailbox (see docs/security/threat-model.md's
# verification roadmap).
GOOGLE_OAUTH_ENABLED=false
# Stage 11A Phase 6A: these were originally one shared flag
# (GOOGLE_OAUTH_INITIATION_ENABLED). A real incident showed that was unsafe —
# enabling it to authorise a connector reconnection also armed OIDC sign-in,
# with no way to authorise one without the other. Two independent flags now
# exist; enabling either one never enables the other. Each must stay false
# until the project owner explicitly authorises that specific flow.
GOOGLE_OIDC_SIGNIN_ENABLED=false
GOOGLE_CONNECTOR_OAUTH_ENABLED=false
# Stage 11A Phase 4D: independent from the flags above — a real, connected
# account still cannot create a Gmail draft or insert a Calendar event while
# this stays false. Only ever set true for an explicitly owner-authorised
# provider-write validation session.
GOOGLE_PROVIDER_WRITES_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=your-oidc-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=GOCSPX-your-oidc-client-secret # pragma: allowlist secret
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8010/auth/google/callback
GOOGLE_CONNECTOR_CLIENT_ID=your-connector-client-id.apps.googleusercontent.com
GOOGLE_CONNECTOR_CLIENT_SECRET=GOCSPX-your-connector-client-secret # pragma: allowlist secret
GOOGLE_CONNECTOR_REDIRECT_URI=http://localhost:8010/connected-accounts/google/callback

# --- Scheduled brief worker (optional, Stage 8 Phase 2 / ADR 0004 D48) -------
# Only the scheduled-brief dispatcher/worker (workers/scheduler_worker.py)
# uses this. The web API itself never requires Redis to be reachable —
# demo mode, dev-login, manual brief generation, and every other route work
# with no Redis running at all. 6380 by default (docker compose's `redis`
# service), like Postgres's 5433, since many dev machines already run a
# Redis on 6379.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Privacy retention defaults (Stage 9 Delivery Phase 1 / ADR 0005) --------
# Provisional PRODUCT retention horizons in days, surfaced read-only by the
# Privacy Centre. These are pilot defaults, not legal mandates, and are NOT
# yet enforced by any job (enforcement is Delivery Phase 2). All must be
# positive integers. Signals follow their source item's lifecycle, and
# pending/uncertain executions are never auto-deleted before reconciliation —
# neither has a day count. Uncomment only to override a default.
# RETENTION_SOURCE_ITEMS_DAYS=30
# RETENTION_BRIEF_VERSIONS_DAYS=90
# RETENTION_UNAPPROVED_PROPOSALS_DAYS=90
# RETENTION_APPROVED_TERMINAL_DAYS=365
# RETENTION_SCHEDULED_RUNS_DAYS=90
# RETENTION_MEMORY_EVIDENCE_DAYS=90
# RETENTION_AUDIT_TOMBSTONE_DAYS=365
# RETENTION_OPERATIONAL_LOGS_DAYS=30
# RETENTION_AGGREGATED_METRICS_DAYS=90

# --- Durable deletion engine (Stage 9 Delivery Phase 2 / ADR 0005) -----------
# The preview/confirm API is always available; retention enforcement only runs
# when RETENTION_ENFORCEMENT_ENABLED=true AND the arq worker is running. Batch
# size bounds each destructive transaction; preview TTL is how long a typed
# confirmation stays valid; heartbeat timeout is when a crashed `running`
# operation is recovered; the per-tick cap prevents an initial retention
# backfill storm. All are positive integers.
# DELETION_BATCH_SIZE=200
# DELETION_PREVIEW_TTL_MINUTES=30
# DELETION_HEARTBEAT_TIMEOUT_MINUTES=10
# DELETION_MAX_ATTEMPTS=3
# RETENTION_ENFORCEMENT_ENABLED=false
# RETENTION_MAX_OPERATIONS_PER_TICK=50

# --- Rate-limiting trusted proxies (Stage 9; enforcement in Delivery Phase 4)
# Comma-separated CIDRs whose immediate-peer proxy may set X-Forwarded-For.
# Empty (the default) means trust NO forwarded headers — the direct peer IP is
# authoritative. Set this only behind a known load balancer / reverse proxy.
# TRUSTED_PROXY_CIDRS=

# --- Rate limiting (Stage 9 Delivery Phase 4 / ADR 0005 D64/D81) ------------
# Off by default, like every other Stage 8/9 feature flag. When enabled,
# requests are keyed by an HMAC digest of the user id or resolved client IP —
# never a raw value — using this secret. Production refuses to start with a
# missing/short secret when enabled; development/test may leave it blank (an
# ephemeral secret is generated at startup, exactly like SESSION_SECRET).
# RATE_LIMITING_ENABLED=false
# RATE_LIMIT_KEY_SECRET=
# RATE_LIMIT_REDIS_PREFIX=ratelimit:v1
# A JSON object overriding individual policies' capacity/refill_amount/
# refill_window_seconds (see rate_limit_policy.py for the closed set of
# policy codes). Empty means no overrides. Example:
# RATE_LIMIT_POLICY_OVERRIDES_JSON={"brief_generate":{"capacity":1,"refill_amount":2,"refill_window_seconds":60}}
# RATE_LIMIT_POLICY_OVERRIDES_JSON=
# RATE_LIMIT_MAX_FORWARDED_HOPS=10
# RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.2

# --- Timeout policy (Stage 9 Delivery Phase 5) -------------------------------
# Every network call the app makes uses one of these central, validated
# timeouts — never a scattered magic number. All must be positive numbers.
# Defaults are conservative pilot values, not tuned for scale.
# GOOGLE_CONNECT_TIMEOUT_SECONDS=5.0
# GOOGLE_READ_TIMEOUT_SECONDS=10.0
# Writes (Gmail draft creation, Calendar event insertion) get a longer
# budget than reads — a local timeout on a write must never be mistaken for
# "Google didn't receive the request" (see apps/api/src/lifeflow_api/timeouts.py).
# GOOGLE_WRITE_TIMEOUT_SECONDS=20.0

# --- Test-only provider-control boundary (Stage 9 Delivery Phase 5) ---------
# NEVER set either of these in a real deployment. `create_app` refuses to
# start if E2E_TEST_CONTROLS_ENABLED=true while ENVIRONMENT=production.
# Used only by scripts/e2e-resilience.sh to redirect the Google clients at
# the test-only fake Google server (apps/api/src/lifeflow_api/testing/
# fake_google_server.py) for the outage-simulation Playwright journeys.
# E2E_TEST_CONTROLS_ENABLED=false
# GOOGLE_API_ORIGIN_OVERRIDE=
# Stage 11A Phase 1 F-002: same gate as above. When set alongside
# E2E_TEST_CONTROLS_ENABLED=true, this ISO-8601 instant replaces the real
# host clock as the "now" the demo/synthetic connectors materialise their
# fixed dataset against (apps/api/src/lifeflow_api/demo_mode.py), so demo
# content — and visual-regression baselines captured against it — stop
# drifting as real time passes. Ignored entirely unless the flag above is
# also true. Never affects sessions, OAuth, or action-proposal expiry,
# which always use the real wall clock.
# DEMO_CLOCK_OVERRIDE=
# Bounds every database query via asyncpg's server_settings — a stuck query
# can never hold a connection (and therefore a request or worker job)
# indefinitely.
# DATABASE_STATEMENT_TIMEOUT_SECONDS=10.0
# The bounded ping GET /ready and GET /scheduled-briefs/status use to check
# Redis reachability.
# WORKER_HEALTH_CHECK_TIMEOUT_SECONDS=0.5
