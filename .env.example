# LifeFlow AI — environment configuration template.
# Copy to .env and adjust. NEVER commit .env or real secrets.
# Only variables consumed by the current stage are listed; later stages add
# their own here (documented, never silently).

# --- Database (docker compose db service) -----------------------------------
# Host port for PostgreSQL. 5433 by default to avoid clashing with any local
# Postgres already on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lifeflow:lifeflow@localhost:5433/lifeflow # pragma: allowlist secret

# --- API ---------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Secrets (generate your own; never commit real values) -------------------
# Signs the session cookie. Optional in development (ephemeral secret is
# generated at startup); REQUIRED in production.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Encrypts OAuth tokens at rest (AES-256-GCM). Required once accounts connect.
# Generate: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_KEY=
# Identifier for the key above; changes when the key is rotated.
TOKEN_KEY_ID=dev-1

# --- LLM-assisted extraction (optional) ---------------------------------------
# Real model calls are DISABLED by default: a key alone does nothing.
# LLM_EXTRACTION_ENABLED must be set to true explicitly, and per ADR 0002 it
# stays false until a real-provider evaluation has been run and recorded.
# Demo mode, tests, and CI never need any of these.
LLM_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Real Google integration (optional, Stage 7 / ADR 0003) -------------------
# Disabled by default: demo mode, dev-login, and the synthetic connectors work
# with none of this set. Setting GOOGLE_OAUTH_ENABLED=true requires BOTH
# client configs below (the app refuses to start otherwise) — they are
# deliberately separate Google Cloud OAuth clients, never one shared client:
#   - the OIDC client signs users into LifeFlow itself (openid email profile
#     only; never mailbox/calendar access);
#   - the connector client is requested only from the Connections screen and
#     carries the four data scopes (gmail.readonly, gmail.compose,
#     calendar.readonly, calendar.events).
# Test against a sandbox Google account on the "Testing" consent-screen
# status first — never a primary mailbox (see docs/security/threat-model.md's
# verification roadmap).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=your-oidc-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=GOCSPX-your-oidc-client-secret # pragma: allowlist secret
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8010/auth/google/callback
GOOGLE_CONNECTOR_CLIENT_ID=your-connector-client-id.apps.googleusercontent.com
GOOGLE_CONNECTOR_CLIENT_SECRET=GOCSPX-your-connector-client-secret # pragma: allowlist secret
GOOGLE_CONNECTOR_REDIRECT_URI=http://localhost:8010/connected-accounts/google/callback

# --- Scheduled brief worker (optional, Stage 8 Phase 2 / ADR 0004 D48) -------
# Only the scheduled-brief dispatcher/worker (workers/scheduler_worker.py)
# uses this. The web API itself never requires Redis to be reachable —
# demo mode, dev-login, manual brief generation, and every other route work
# with no Redis running at all. 6380 by default (docker compose's `redis`
# service), like Postgres's 5433, since many dev machines already run a
# Redis on 6379.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
