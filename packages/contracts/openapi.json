{
  "components": {
    "schemas": {
      "DemoStartResponse": {
        "properties": {
          "imported": {
            "title": "Imported",
            "type": "integer"
          },
          "skipped": {
            "title": "Skipped",
            "type": "integer"
          },
          "updated": {
            "title": "Updated",
            "type": "integer"
          }
        },
        "required": [
          "imported",
          "updated",
          "skipped"
        ],
        "title": "DemoStartResponse",
        "type": "object"
      },
      "DevLoginRequest": {
        "properties": {
          "display_name": {
            "default": "Dev User",
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "default": "dev@lifeflow.local",
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "title": "DevLoginRequest",
        "type": "object"
      },
      "ExtractionResponse": {
        "properties": {
          "deterministic": {
            "title": "Deterministic",
            "type": "integer"
          },
          "llm_added": {
            "title": "Llm Added",
            "type": "integer"
          },
          "llm_failed": {
            "title": "Llm Failed",
            "type": "boolean"
          },
          "llm_rejected": {
            "title": "Llm Rejected",
            "type": "integer"
          },
          "llm_used": {
            "title": "Llm Used",
            "type": "boolean"
          },
          "persisted_new": {
            "title": "Persisted New",
            "type": "integer"
          },
          "persisted_updated": {
            "title": "Persisted Updated",
            "type": "integer"
          }
        },
        "required": [
          "deterministic",
          "llm_used",
          "llm_added",
          "llm_rejected",
          "llm_failed",
          "persisted_new",
          "persisted_updated"
        ],
        "title": "ExtractionResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "onboarding_state": {
            "title": "Onboarding State",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "timezone",
          "locale",
          "onboarding_state"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MeUpdateRequest": {
        "properties": {
          "locale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "onboarding_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OnboardingState"
              },
              {
                "type": "null"
              }
            ]
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "MeUpdateRequest",
        "type": "object"
      },
      "OnboardingState": {
        "enum": [
          "new",
          "in_progress",
          "complete"
        ],
        "title": "OnboardingState",
        "type": "string"
      },
      "SessionResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SignalListResponse": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/SignalResponse"
            },
            "title": "Signals",
            "type": "array"
          }
        },
        "required": [
          "signals",
          "count"
        ],
        "title": "SignalListResponse",
        "type": "object"
      },
      "SignalResponse": {
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "extraction_version": {
            "title": "Extraction Version",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "priority_band": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority Band"
          },
          "priority_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority Score"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "signal_type": {
            "title": "Signal Type",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "signal_type",
          "title",
          "summary",
          "evidence_refs",
          "due_at",
          "confidence",
          "priority_score",
          "priority_band",
          "reason_codes",
          "extraction_version"
        ],
        "title": "SignalResponse",
        "type": "object"
      },
      "SourceItemListResponse": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceItemResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "count"
        ],
        "title": "SourceItemListResponse",
        "type": "object"
      },
      "SourceItemResponse": {
        "properties": {
          "external_id": {
            "title": "External Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "sender_or_organiser": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender Or Organiser"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_type",
          "external_id",
          "title",
          "sender_or_organiser",
          "occurred_at",
          "metadata"
        ],
        "title": "SourceItemResponse",
        "type": "object"
      },
      "SourceType": {
        "enum": [
          "email",
          "calendar_event",
          "internal_task"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LifeFlow AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/dev-login": {
      "post": {
        "operationId": "dev_login_auth_dev_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dev Login"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/demo/start": {
      "post": {
        "operationId": "start_demo_demo_start_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoStartResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Start Demo"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/me": {
      "get": {
        "operationId": "get_me_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Me"
      },
      "patch": {
        "operationId": "update_me_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Me"
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/signals": {
      "get": {
        "operationId": "list_signals_signals_get",
        "parameters": [
          {
            "in": "query",
            "name": "band",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(high|medium|low)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Band"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Signals"
      }
    },
    "/signals/extract": {
      "post": {
        "operationId": "extract_signals_signals_extract_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Extract Signals"
      }
    },
    "/source-items": {
      "get": {
        "operationId": "list_source_items_source_items_get",
        "parameters": [
          {
            "in": "query",
            "name": "source_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SourceType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source Type"
            }
          },
          {
            "in": "query",
            "name": "occurring_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Occurring After"
            }
          },
          {
            "in": "query",
            "name": "occurring_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Occurring Before"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceItemListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Source Items"
      }
    }
  }
}
